API_KEY="YOUR_FINNHUB_API_KEY"
BASE_URL="https://finnhub.io/api/v1/quote"
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=stock-quotes
AWS_REGION=us-east-1
S3_BUCKET=your-bucket
AWS_PROFILE=your-profile
SNOWFLAKE_STAGE_URL=s3://your-bucket/topic=stock-quotes/
SNOWFLAKE_STORAGE_INTEGRATION=your_integration_name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
USE_MINIO=false
DIRECT_TO_S3=false
S3_PREFLIGHT_CHECK=false
S3_BASE_PREFIX=
PARQUET_COMPRESSION=snappy
BATCH_SIZE=500
MAX_BATCH_SECONDS=10
MAX_BATCH_BYTES=1048576
OFFSET_BUCKET_SIZE=500
MAX_BUCKET_SECONDS=15
SCHEMA_VALIDATION_ENABLED=true
SCHEMA_FILE=ifra/consumer/schema/stock_quote.schema.json
DLQ_PREFIX=dlq
QUARANTINE_PREFIX=quarantine
KAFKA_DLQ_TOPIC=stock-quotes-dlq
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=your-minio-bucket
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_ACCOUNT=your-snowflake-account
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=stocks_mds
SNOWFLAKE_SCHEMA=stocks_mds.common
